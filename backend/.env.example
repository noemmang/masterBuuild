APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=https://masterbuild.noemmang.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Producción: MAIL_MAILER=resend + RESEND_API_KEY (requiere
# `composer require resend/resend-laravel`, ver README).
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Scraping ────────────────────────────────────────────────────────────
# Estrategia de descarga: direct (IP del contenedor) | proxy | api
SCRAPER_MODO=direct
# Modo proxy: http://usuario:clave@host:puerto  (proxy RESIDENCIAL/ISP con IP de España)
SCRAPER_PROXY=
# Modo api: plantilla con {url}, p. ej. https://app.scrapingbee.com/api/v1/?api_key=KEY&render_js=false&country_code=es&url={url}
SCRAPER_API_URL_TEMPLATE=
SCRAPER_TIMEOUT=25
SCRAPER_CONNECT_TIMEOUT=10
SCRAPER_REINTENTOS=1
# Mantener alineado con el Chrome estable actual (octubre 2026: 156)
SCRAPER_CHROME_MAJOR=156

# Alertas (todas opcionales)
SCRAPER_ALERT_WEBHOOK=
SCRAPER_ALERT_EMAIL=
# URL de ping de healthchecks.io (avisa aunque el Job no llegue a ejecutarse)
SCRAPER_HEARTBEAT_URL=
SCRAPER_HORAS_OBSOLETO=30

# En Azure: que los logs de Laravel salgan por stderr (→ Log Analytics)
# LOG_STACK=stderr